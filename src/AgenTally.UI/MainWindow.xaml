<Window x:Class="AgenTally.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}"
        Width="960"
        Height="680"
        MinWidth="900"
        MinHeight="640"
        Icon="Resources/AgenTally.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid Background="{DynamicResource TopBarBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="122" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="CaptionBar"
                Grid.ColumnSpan="2"
                Background="{DynamicResource TopBarBrush}">
            <Grid>
                <StackPanel Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding WindowTitle}" />
                    <Border Width="1"
                            Height="13"
                            Margin="12,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BorderBrush}" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{DynamicResource MutedTextStyle}"
                               Text="{Binding CurrentPage.Title}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button x:Name="CaptionMinimizeButton"
                            Click="OnCaptionMinimizeClick"
                            Style="{DynamicResource CaptionMinimizeButtonStyle}"
                            ToolTip="最小化" />
                    <Button x:Name="CaptionMaximizeRestoreButton"
                            Click="OnCaptionMaximizeRestoreClick"
                            Style="{DynamicResource CaptionMaximizeButtonStyle}"
                            ToolTip="最大化/还原" />
                    <Button x:Name="CaptionCloseButton"
                            Click="OnCaptionCloseClick"
                            Style="{DynamicResource CaptionCloseButtonStyle}"
                            ToolTip="关闭" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="NavigationSidebar"
                Grid.Row="1"
                Background="{DynamicResource TopBarBrush}">
            <Grid>
                <ListBox x:Name="NavigationList"
                         Margin="8,12"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Top"
                         HorizontalContentAlignment="Stretch"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding CurrentPage, Mode=OneWay}"
                         PreviewMouseDown="OnNavigationPreviewMouseDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,3" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemSurface"
                                                Padding="{TemplateBinding Padding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button HorizontalAlignment="Stretch"
                                    Content="{Binding Title}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{DynamicResource NavButtonStyle}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="SidebarStatusArea"
                            Margin="12,0,12,18"
                            VerticalAlignment="Bottom">
                    <Border x:Name="SidebarCoreStatus"
                            Margin="0,0,0,12"
                            Padding="10,9"
                            CornerRadius="8"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource PositiveSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PositiveBrush}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCoreStatusVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CoreStatusIsError}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock FontSize="10.5"
                                       LineHeight="15"
                                       Text="{Binding CoreStatusText}"
                                       TextWrapping="Wrap" />
                            <StackPanel Margin="0,6,0,0">
                                <Button x:Name="OpenSourcesButton"
                                        Content="查看数据来源"
                                        Command="{Binding NavigateToSourcesCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TextLinkButtonStyle}">
                                            <Setter Property="FontSize" Value="10.5" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CoreStatusCanOpenSources}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="RetryCoreButton"
                                        Content="重试"
                                        Command="{Binding RetryCoreCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TextLinkButtonStyle}">
                                            <Setter Property="FontSize" Value="10.5" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CoreStatusCanRetry}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SidebarPageError"
                            Margin="0,0,0,12"
                            Padding="10,9"
                            Background="{DynamicResource ErrorSoftBrush}"
                            BorderBrush="{DynamicResource ErrorBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding CurrentPage.HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="10.5"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   LineHeight="15"
                                   Text="{Binding CurrentPage.ErrorMessage}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel x:Name="SidebarRefreshStatus"
                                Margin="0,0,0,10"
                                Visibility="{Binding CurrentPage.IsRefreshFeedbackVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock x:Name="SidebarLoadingText"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="正在加载…" />
                        <ProgressBar x:Name="SidebarLoadingProgress"
                                     Margin="0,7,0,0"
                                     HorizontalAlignment="Stretch"
                                     Style="{DynamicResource LoadingProgressBarStyle}" />
                    </StackPanel>

                    <TextBlock x:Name="SidebarVersionText"
                               FontSize="10"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="{Binding Settings.ApplicationVersion, StringFormat=版本 {0}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="MainContentSurface"
                Grid.Row="1"
                Grid.Column="1"
                Background="{DynamicResource AppBackgroundBrush}"
                CornerRadius="16,0,0,0"
                ClipToBounds="True">
            <Grid>
                <ContentControl x:Name="PageContent"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Content="{Binding CurrentPage}">
                    <ContentControl.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
        </Border>
    </Grid>
</Window>
