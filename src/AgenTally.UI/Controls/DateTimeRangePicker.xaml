<UserControl x:Class="AgenTally.UI.Controls.DateTimeRangePicker"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="OnPreviewKeyDown"
             Unloaded="OnUnloaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="26" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="StartTrigger"
                AutomationProperties.AutomationId="DateTimeRange.StartTrigger"
                Click="OnTriggerClick"
                Style="{StaticResource DateTimeRangeTriggerButtonStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="10"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="起始时间" />
                    <TextBlock x:Name="StartValueText"
                               Margin="0,1,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="请选择" />
                </StackPanel>
                <Path Grid.Column="1"
                      Width="12"
                      Height="12"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Data="M2,3 H10 V10 H2 Z M2,5 H10 M4,1 V4 M8,1 V4"
                      Stroke="{DynamicResource TextSecondaryBrush}"
                      StrokeLineJoin="Round"
                      StrokeThickness="1.2" />
            </Grid>
        </Button>

        <TextBlock Grid.Column="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Text="→" />

        <Button x:Name="EndTrigger"
                Grid.Column="2"
                AutomationProperties.AutomationId="DateTimeRange.EndTrigger"
                Click="OnTriggerClick"
                Style="{StaticResource DateTimeRangeTriggerButtonStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="10"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="结束时间（不含）" />
                    <TextBlock x:Name="EndValueText"
                               Margin="0,1,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="请选择" />
                </StackPanel>
                <Path Grid.Column="1"
                      Width="12"
                      Height="12"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Data="M2,3 H10 V10 H2 Z M2,5 H10 M4,1 V4 M8,1 V4"
                      Stroke="{DynamicResource TextSecondaryBrush}"
                      StrokeLineJoin="Round"
                      StrokeThickness="1.2" />
            </Grid>
        </Button>

        <Popup x:Name="PickerPopup"
               Grid.ColumnSpan="3"
               AllowsTransparency="True"
               Closed="OnPopupClosed"
               Focusable="True"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=Root}"
               PopupAnimation="Fade"
               StaysOpen="False">
            <Border Width="358"
                    Margin="0,6,0,0"
                    Padding="14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    KeyboardNavigation.TabNavigation="Cycle"
                    PreviewKeyDown="OnPreviewKeyDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="StageTitle"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="StageHint"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                        <Button x:Name="BackButton"
                                Width="54"
                                Height="28"
                                Padding="0"
                                HorizontalAlignment="Right"
                                Click="OnBackClick"
                                Content="返回"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <ItemsControl x:Name="ProgressItems"
                                  Grid.Row="1"
                                  Margin="0,12,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ProgressChip"
                                        Margin="2,0"
                                        Padding="3,5"
                                        Background="{DynamicResource SurfaceSubtleBrush}"
                                        CornerRadius="6">
                                    <TextBlock x:Name="ProgressLabel"
                                               HorizontalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="{Binding Label}" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="ProgressChip"
                                                Property="Background"
                                                Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter TargetName="ProgressLabel"
                                                Property="Foreground"
                                                Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                        <Setter TargetName="ProgressChip"
                                                Property="Background"
                                                Value="{DynamicResource AccentSoftBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Calendar x:Name="DateCalendar"
                              Grid.Row="2"
                              DisplayDateChanged="OnCalendarDisplayDateChanged"
                              LostMouseCapture="OnCalendarLostMouseCapture"
                              PreviewMouseLeftButtonDown="OnCalendarPreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="OnCalendarPreviewMouseLeftButtonUp"
                              SelectedDatesChanged="OnSelectedDatesChanged"
                              SelectionMode="SingleDate"
                              Style="{StaticResource DateTimeRangeCalendarStyle}" />

                    <ItemsControl x:Name="HourItems"
                                  Grid.Row="2"
                                  Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" Rows="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button AutomationProperties.Name="{Binding Label}"
                                        Click="OnHourClick"
                                        Content="{Binding Label}"
                                        IsEnabled="{Binding IsEnabled}"
                                        Style="{StaticResource DateTimeRangeHourButtonStyle}"
                                        Tag="{Binding Hour}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="3"
                            Margin="0,12,0,0"
                            Padding="9,7"
                            Background="{DynamicResource SurfaceSubtleBrush}"
                            CornerRadius="7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Text="系统时区 · " />
                            <TextBlock x:Name="TimeZoneText"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
