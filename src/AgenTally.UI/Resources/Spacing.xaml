<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared layout tokens: every page and card consumes these instead of ad-hoc values. -->
    <Thickness x:Key="PageMargin">24,16,24,24</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="CardStackGap">0,16,0,0</Thickness>
    <Thickness x:Key="CardColumnGap">16,0,0,0</Thickness>
    <Thickness x:Key="StatisticsFirstContentGap">0,8,0,0</Thickness>
    <Thickness x:Key="StatisticsFirstContentColumnGap">16,8,0,0</Thickness>
    <Thickness x:Key="StatisticsHeaderScrollbarReserve">0,0,17,0</Thickness>
    <GridLength x:Key="CardGapLength">16</GridLength>
    <CornerRadius x:Key="CardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">9</CornerRadius>
    <CornerRadius x:Key="ControlInnerCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="TableInnerCornerRadius">13</CornerRadius>
</ResourceDictionary>
