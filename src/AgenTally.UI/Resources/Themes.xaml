<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Colors.LocalLedger.xaml" />
        <ResourceDictionary Source="Brushes.xaml" />
        <ResourceDictionary Source="Spacing.xaml" />
        <ResourceDictionary Source="Styles/Typography.xaml" />
        <ResourceDictionary Source="Styles/LayoutStyles.xaml" />
        <ResourceDictionary Source="Styles/ButtonStyles.xaml" />
        <ResourceDictionary Source="Styles/ScrollBarStyles.xaml" />
        <ResourceDictionary Source="Styles/InputStyles.xaml" />
        <ResourceDictionary Source="Styles/DataGridStyles.xaml" />
        <ResourceDictionary Source="Styles/TabStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Keep keyboard focus and control-specific focus states, but replace
         WPF's dashed system focus adorner with an invisible visual globally. -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}"
           TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid Opacity="0"
                          IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
