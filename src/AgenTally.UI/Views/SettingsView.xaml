<UserControl x:Class="AgenTally.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AgenTally.UI.Controls"
             xmlns:viewModels="clr-namespace:AgenTally.UI.ViewModels">
    <UserControl.Resources>
        <Style x:Key="PriceSectionToggleStyle"
               TargetType="ToggleButton">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleSurface"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PriceFilterToggleStyle"
               TargetType="ToggleButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="FilterSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterSurface"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="FilterSurface"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="FilterSurface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSwitchStyle"
               TargetType="ToggleButton">
            <Setter Property="Width" Value="94" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SwitchSurface"
                                Padding="3"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SwitchTrack"
                                        Width="44"
                                        Height="24"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Border x:Name="SwitchThumb"
                                            Width="18"
                                            Height="18"
                                            Margin="2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9" />
                                </Border>
                                <TextBlock x:Name="SwitchStateText"
                                           Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13"
                                           Text="关闭" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchSurface"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="SwitchTrack"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="SwitchThumb"
                                        Property="HorizontalAlignment"
                                        Value="Right" />
                                <Setter TargetName="SwitchStateText"
                                        Property="Text"
                                        Value="开启" />
                                <Setter TargetName="SwitchStateText"
                                        Property="Foreground"
                                        Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PriceEditorTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource BaseTextBoxStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInheritedPriceEditor}"
                             Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource SurfaceSubtleBrush}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextSecondaryBrush}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource BorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsCategoryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CategorySurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CardCornerRadius}">
                            <Grid>
                                <Border x:Name="HoverOverlay"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        CornerRadius="{DynamicResource TableInnerCornerRadius}"
                                        Opacity="0" />
                                <Border x:Name="PressedOverlay"
                                        Background="{DynamicResource SurfaceSubtleBrush}"
                                        CornerRadius="{DynamicResource TableInnerCornerRadius}"
                                        Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay"
                                        Property="Opacity"
                                        Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressedOverlay"
                                        Property="Opacity"
                                        Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="SettingsScrollViewer"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid x:Name="SettingsContentGrid"
              Margin="{DynamicResource PageMargin}"
              MaxWidth="1500"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="SettingsHomeTitle"
                       Text="设置"
                       Visibility="{Binding IsSettingsHome, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Style="{DynamicResource PageTitleStyle}" />

            <Grid x:Name="SettingsDetailHeader"
                  Visibility="{Binding IsSettingsDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:Name="BackToSettingsHomeButton"
                        Height="40"
                        Padding="12,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="返回设置"
                        Command="{Binding BackToSettingsHomeCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16"
                                 Height="16"
                                 VerticalAlignment="Center">
                            <Path x:Name="BackToSettingsHomeIcon"
                                  Width="18"
                                  Height="16"
                                  Data="M 8,1 L 1,8 L 8,15 M 1,8 L 17,8"
                                  Fill="Transparent"
                                  Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.6" />
                        </Viewbox>
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="返回设置" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Row="1"
                           Margin="0,14,0,0"
                           Text="{Binding SettingsSectionTitle}"
                           Style="{DynamicResource PageTitleStyle}" />
            </Grid>

            <UniformGrid x:Name="SettingsCategoryGrid"
                         Grid.Row="1"
                         Margin="-6,10,-6,-6"
                         Columns="2"
                         Visibility="{Binding IsSettingsHome, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button x:Name="GeneralSettingsCard"
                        AutomationProperties.Name="进入常规设置"
                        Command="{Binding OpenSettingsSectionCommand}"
                        CommandParameter="{x:Static viewModels:SettingsSection.General}"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="常规设置"
                                   Style="{DynamicResource SectionTitleStyle}" />
                        <TextBlock Grid.Column="1"
                                   Margin="18,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="22"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="›" />
                    </Grid>
                </Button>
                <Button x:Name="DataAndBackupSettingsCard"
                        AutomationProperties.Name="进入数据与备份"
                        Command="{Binding OpenSettingsSectionCommand}"
                        CommandParameter="{x:Static viewModels:SettingsSection.DataAndBackup}"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="数据与备份"
                                   Style="{DynamicResource SectionTitleStyle}" />
                        <TextBlock Grid.Column="1"
                                   Margin="18,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="22"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="›" />
                    </Grid>
                </Button>
                <Button x:Name="PricingSettingsCard"
                        AutomationProperties.Name="进入模型与计价"
                        Command="{Binding OpenSettingsSectionCommand}"
                        CommandParameter="{x:Static viewModels:SettingsSection.Pricing}"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="模型与计价"
                                   Style="{DynamicResource SectionTitleStyle}" />
                        <TextBlock Grid.Column="1"
                                   Margin="18,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="22"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="›" />
                    </Grid>
                </Button>
                <Button x:Name="PrivacySettingsCard"
                        AutomationProperties.Name="进入隐私与安全"
                        Command="{Binding OpenSettingsSectionCommand}"
                        CommandParameter="{x:Static viewModels:SettingsSection.Privacy}"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="隐私与安全"
                                   Style="{DynamicResource SectionTitleStyle}" />
                        <TextBlock Grid.Column="1"
                                   Margin="18,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="22"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="›" />
                    </Grid>
                </Button>
                <Button x:Name="AboutSettingsCard"
                        AutomationProperties.Name="进入关于与更新"
                        Command="{Binding OpenSettingsSectionCommand}"
                        CommandParameter="{x:Static viewModels:SettingsSection.About}"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="关于与更新"
                                   Style="{DynamicResource SectionTitleStyle}" />
                        <TextBlock Grid.Column="1"
                                   Margin="18,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="22"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="›" />
                    </Grid>
                </Button>
            </UniformGrid>

            <Border Grid.Row="2"
                    Margin="{DynamicResource CardStackGap}"
                    Padding="{DynamicResource CardPadding}"
                    Visibility="{Binding IsPricingSettings, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="PriceManagerHeader">
                        <TextBlock Text="模型价格"
                                   Style="{DynamicResource SectionTitleStyle}" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding PriceSummaryText}"
                                   TextWrapping="Wrap"
                                   Style="{DynamicResource SecondaryTextStyle}" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding PriceDraftStatusText}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding HasUnsavedPriceChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <Grid Grid.Row="1"
                          Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="236" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel VerticalAlignment="Center">
                                <ToggleButton x:Name="AllPriceFilterToggle"
                                              Content="{Binding AllPriceFilterText}"
                                              IsChecked="{Binding IsAllPriceFilterSelected, Mode=OneWay}"
                                              Command="{Binding SetPriceFilterCommand}"
                                              CommandParameter="{x:Static viewModels:PriceModelFilter.All}"
                                              Style="{StaticResource PriceFilterToggleStyle}" />
                                <ToggleButton x:Name="UnpricedPriceFilterToggle"
                                              Content="{Binding UnpricedPriceFilterText}"
                                              IsChecked="{Binding IsUnpricedFilterSelected, Mode=OneWay}"
                                              Command="{Binding SetPriceFilterCommand}"
                                              CommandParameter="{x:Static viewModels:PriceModelFilter.Unpriced}"
                                              Style="{StaticResource PriceFilterToggleStyle}" />
                                <ToggleButton x:Name="CustomPriceFilterToggle"
                                              Content="{Binding CustomPriceFilterText}"
                                              IsChecked="{Binding IsCustomFilterSelected, Mode=OneWay}"
                                              Command="{Binding SetPriceFilterCommand}"
                                              CommandParameter="{x:Static viewModels:PriceModelFilter.Custom}"
                                              Style="{StaticResource PriceFilterToggleStyle}" />
                            </WrapPanel>
                            <TextBox x:Name="PriceSearchTextBox"
                                     Grid.Column="1"
                                     Text="{Binding PriceSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="只搜索已经产生记录或已有自定义价格的模型"
                                     AutomationProperties.Name="筛选已有模型价格" />
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="400" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:RoundedClipBorder Style="{DynamicResource TableCardStyle}">
                                <Grid>
                                    <DataGrid x:Name="PriceModelGrid"
                                              Height="306"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserReorderColumns="False"
                                              CanUserResizeRows="False"
                                              CanUserSortColumns="False"
                                              EnableColumnVirtualization="True"
                                              EnableRowVirtualization="True"
                                              HeadersVisibility="Column"
                                              IsReadOnly="True"
                                              ItemsSource="{Binding PriceModels}"
                                              SelectedItem="{Binding SelectedPriceModel, Mode=TwoWay}">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="*"
                                                                    MinWidth="180"
                                                                    Header="模型">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding NormalizedModel}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding NormalizedModel}"
                                                                   Style="{StaticResource DataGridTextStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Width="96"
                                                                Header="状态"
                                                                Binding="{Binding SourceText}"
                                                                ElementStyle="{StaticResource DataGridTextStyle}" />
                                            <DataGridTextColumn Width="80"
                                                                Header="记录"
                                                                HeaderStyle="{StaticResource DataGridNumericHeaderStyle}"
                                                                Binding="{Binding ObservedRecordsText}"
                                                                ElementStyle="{StaticResource DataGridNumberTextStyle}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Margin="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="没有符合当前筛选的模型。模型产生使用记录后会自动出现。"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasNoVisiblePriceModels, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Style="{DynamicResource SecondaryTextStyle}" />
                                </Grid>
                            </controls:RoundedClipBorder>

                            <Border x:Name="PriceEditorPanel"
                                    Grid.Column="2"
                                    Padding="14,12"
                                    Style="{DynamicResource InsetPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SelectedPriceModel.NormalizedModel, TargetNullValue=请选择模型}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedPriceModel.NormalizedModel}"
                                                   Style="{DynamicResource SectionTitleStyle}" />
                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    HorizontalAlignment="Right">
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding SelectedPriceModel.SourceText}"
                                                       Style="{DynamicResource CaptionTextStyle}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       HorizontalAlignment="Right"
                                                       Text="USD / 百万 Token"
                                                       Style="{DynamicResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          Margin="0,12,0,0"
                                          IsEnabled="{Binding CanEditSelectedPrice}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,5"
                                                       Text="输入（必填）"
                                                       Style="{DynamicResource CaptionTextStyle}" />
                                            <TextBox x:Name="InputPriceTextBox"
                                                     Text="{Binding InputRateText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="0–1,000,000 USD / 百万 Token"
                                                     Style="{StaticResource PriceEditorTextBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5"
                                                       Text="缓存输入（可空）"
                                                       Style="{DynamicResource CaptionTextStyle}" />
                                            <TextBox Text="{Binding CachedInputRateText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="留空时该 Token 类别不计价"
                                                     Style="{StaticResource PriceEditorTextBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1"
                                                    Margin="0,10,0,0">
                                            <TextBlock Margin="0,0,0,5"
                                                       Text="缓存写入（可空）"
                                                       Style="{DynamicResource CaptionTextStyle}" />
                                            <TextBox Text="{Binding CacheWriteRateText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="留空时该 Token 类别不计价"
                                                     Style="{StaticResource PriceEditorTextBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="2"
                                                    Margin="0,10,0,0">
                                            <TextBlock Margin="0,0,0,5"
                                                       Text="输出（必填）"
                                                       Style="{DynamicResource CaptionTextStyle}" />
                                            <TextBox Text="{Binding OutputRateText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="0–1,000,000 USD / 百万 Token"
                                                     Style="{StaticResource PriceEditorTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="2"
                                            Margin="0,14,0,0"
                                            Background="{DynamicResource SurfaceSubtleBrush}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}">
                                        <ToggleButton x:Name="LongContextPriceToggle"
                                                      Padding="10,8"
                                                      IsChecked="{Binding IsLongContextExpanded, Mode=TwoWay}"
                                                      Style="{StaticResource PriceSectionToggleStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="长上下文计价"
                                                           Style="{DynamicResource BodyTextStyle}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="12,0,0,0"
                                                           Text="{Binding LongContextSummaryText}"
                                                           Style="{DynamicResource CaptionTextStyle}" />
                                                <TextBlock Grid.Column="2"
                                                           Margin="10,0,2,0"
                                                           Text="{Binding LongContextToggleGlyph}"
                                                           Style="{DynamicResource SecondaryTextStyle}" />
                                            </Grid>
                                        </ToggleButton>
                                    </Border>

                                    <Grid Grid.Row="3"
                                          Margin="0,10,0,0"
                                          IsEnabled="{Binding CanEditSelectedPrice}"
                                          Visibility="{Binding IsLongContextExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,5"
                                                       Text="阈值 Token"
                                                       Style="{DynamicResource CaptionTextStyle}" />
                                            <TextBox Text="{Binding LongContextThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="可空；填写正整数 Token 数"
                                                     Style="{StaticResource PriceEditorTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5"
                                                       Text="输入倍率"
                                                       Style="{DynamicResource CaptionTextStyle}" />
                                            <TextBox Text="{Binding LongContextInputMultiplierText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="1–100"
                                                     Style="{StaticResource PriceEditorTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Margin="0,0,0,5"
                                                       Text="输出倍率"
                                                       Style="{DynamicResource CaptionTextStyle}" />
                                            <TextBox Text="{Binding LongContextOutputMultiplierText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="1–100"
                                                     Style="{StaticResource PriceEditorTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="4"
                                          Margin="0,14,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding PriceValidationMessage}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ErrorBrush}"
                                                       Visibility="{Binding HasPriceValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding PriceOperationMessage}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HasPriceOperationMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource SecondaryTextStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PriceOperationIsError}"
                                                                         Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource ErrorBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Grid Grid.Row="1"
                                              Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="DiscardPriceChangesButton"
                                                    Grid.Column="0"
                                                    MinWidth="0"
                                                    Padding="10,0"
                                                    Content="放弃更改"
                                                    Command="{Binding DiscardPriceChangesCommand}"
                                                    Style="{DynamicResource SecondaryButtonStyle}" />
                                            <Button x:Name="RestoreSelectedPriceButton"
                                                    Grid.Column="2"
                                                    MinWidth="0"
                                                    Padding="10,0"
                                                    Content="{Binding SelectedPriceRestoreText}"
                                                    Command="{Binding RestorePriceCommand}"
                                                    Style="{DynamicResource SecondaryButtonStyle}" />
                                            <Button x:Name="SavePriceChangesButton"
                                                    Grid.Column="4"
                                                    MinWidth="0"
                                                    Padding="10,0"
                                                    Content="保存更改"
                                                    Command="{Binding SavePriceCommand}"
                                                    ToolTip="自定义价格只影响尚未计价和未来记录，已计价历史保持不变。"
                                                    Style="{DynamicResource PrimaryButtonStyle}" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Button x:Name="RestoreAllPricesButton"
                                Grid.Row="2"
                                MinWidth="148"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Content="{Binding RestoreAllPricesText}"
                                Command="{Binding RestoreAllPricesCommand}"
                                Visibility="{Binding HasCustomPriceModels, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{DynamicResource SecondaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Margin="{DynamicResource CardStackGap}"
                    Padding="{DynamicResource CardPadding}"
                    Visibility="{Binding IsDataAndBackupSettings, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="数据概况"
                               Style="{DynamicResource SectionTitleStyle}" />
                    <UniformGrid x:Name="DataOverviewGrid"
                                 Grid.Row="1"
                                 Margin="-6,8,-6,-6"
                                 Columns="2">
                        <Border Margin="6"
                                Padding="14,11"
                                Style="{DynamicResource InsetPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="数据库大小"
                                           Style="{DynamicResource CaptionTextStyle}" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="{Binding DatabaseSizeText}"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{DynamicResource BodyTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6"
                                Padding="14,11"
                                Style="{DynamicResource InsetPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="统计调用数"
                                           Style="{DynamicResource CaptionTextStyle}" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="{Binding DataRequestCountText}"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{DynamicResource BodyTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="DataTimeRangeMetricCard"
                                Margin="6"
                                Padding="14,11"
                                Style="{DynamicResource InsetPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="数据时间范围"
                                           Style="{DynamicResource CaptionTextStyle}" />
                                <TextBlock x:Name="DataTimeRangeValueText"
                                           Margin="0,5,0,0"
                                           Text="{Binding DataTimeRangeText}"
                                           TextWrapping="Wrap"
                                           ToolTip="{Binding DataTimeRangeText}"
                                           Style="{DynamicResource BodyTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="LastBackupMetricCard"
                                Margin="6"
                                Padding="14,11"
                                Style="{DynamicResource InsetPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="最近备份"
                                           Style="{DynamicResource CaptionTextStyle}" />
                                <TextBlock x:Name="LastBackupValueText"
                                           Margin="0,5,0,0"
                                           Text="{Binding LastBackupText}"
                                           TextWrapping="Wrap"
                                           ToolTip="{Binding LastBackupText}"
                                           Style="{DynamicResource BodyTextStyle}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <StackPanel Grid.Row="2"
                                Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="本地备份"
                                       Style="{DynamicResource SectionTitleStyle}" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="备份可能包含本地项目路径、会话名称和截断 Prompt 摘要。"
                                       TextWrapping="Wrap"
                                       Style="{DynamicResource SecondaryTextStyle}" />
                        </StackPanel>
                        <WrapPanel Margin="0,12,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center">
                            <Button x:Name="CreateBackupButton"
                                    MinWidth="112"
                                    Margin="0,0,8,0"
                                    Content="立即备份"
                                    Command="{Binding DataContext.CreateBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{DynamicResource PrimaryButtonStyle}" />
                            <Button x:Name="RestoreBackupButton"
                                    MinWidth="112"
                                    Margin="0,0,8,0"
                                    Content="恢复备份"
                                    Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{DynamicResource SecondaryButtonStyle}" />
                            <Button x:Name="CancelBackupButton"
                                    MinWidth="96"
                                    Content="取消备份"
                                    Command="{Binding DataContext.CancelBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding DataContext.CanCancelBackup, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Style="{DynamicResource SecondaryButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>
                    <Border Grid.Row="3"
                            Margin="0,14,0,0"
                            Padding="14,11"
                            Visibility="{Binding DataContext.HasDataMaintenanceStatus, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{DynamicResource InsetPanelStyle}">
                        <TextBlock Text="{Binding DataContext.DataMaintenanceStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource SecondaryTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.DataMaintenanceStatusIsError, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="5"
                    Margin="{DynamicResource CardStackGap}"
                    Padding="{DynamicResource CardPadding}"
                    Visibility="{Binding IsDataAndBackupSettings, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ToggleButton x:Name="DataStorageToggle"
                                  Margin="-8"
                                  IsChecked="{Binding IsDataStorageExpanded, Mode=TwoWay}"
                                  AutomationProperties.Name="展开或折叠高级设置"
                                  Style="{StaticResource PriceSectionToggleStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="高级设置"
                                       Style="{DynamicResource SectionTitleStyle}" />
                            <TextBlock Grid.Column="1"
                                       Margin="18,0,4,0"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding DataStorageToggleGlyph}" />
                        </Grid>
                    </ToggleButton>
                    <Grid Grid.Row="1"
                          Margin="0,16,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDataStorageExpanded}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="数据库路径"
                                   Style="{DynamicResource SecondaryTextStyle}" />
                        <TextBox x:Name="DatabasePathTextBox"
                                 Grid.Column="1"
                                 Text="{Binding DatabasePath, Mode=OneWay}"
                                 ToolTip="{Binding DatabasePath}"
                                 Style="{DynamicResource ReadOnlyTextBoxStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="7"
                    Margin="{DynamicResource CardStackGap}"
                    Padding="{DynamicResource CardPadding}"
                    Visibility="{Binding IsAboutSettings, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VersionCheckTitleText"
                                   VerticalAlignment="Center"
                                   Text="版本更新"
                                   Style="{DynamicResource SectionTitleStyle}" />
                        <Button x:Name="ManualVersionCheckButton"
                                Grid.Column="1"
                                MinWidth="128"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center"
                                Content="检查更新"
                                Command="{Binding CheckForUpdatesCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}" />
                    </Grid>
                    <Border Grid.Row="1"
                            Margin="0,14,0,0"
                            Padding="14,11"
                            Visibility="{Binding HasVersionCheckStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{DynamicResource InsetPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding VersionCheckStatusText}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource SecondaryTextStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VersionCheckStatusIsError}"
                                                         Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="OpenReleasePageButton"
                                    Grid.Column="1"
                                    MinWidth="112"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="打开发布页"
                                    Command="{Binding OpenReleasePageCommand}"
                                    Visibility="{Binding CanOpenReleasePage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Style="{DynamicResource PrimaryButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Margin="{DynamicResource CardStackGap}"
                    Padding="{DynamicResource CardPadding}"
                    Visibility="{Binding IsDataAndBackupSettings, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="数据维护"
                               Style="{DynamicResource SectionTitleStyle}" />
                    <Grid Grid.Row="1"
                          Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RescanStatisticsTitleText"
                                   VerticalAlignment="Center"
                                   Text="重新扫描全部 Agent 统计"
                                   Style="{DynamicResource BodyTextStyle}" />
                        <Button x:Name="ManualCodexRescanButton"
                                Grid.Column="1"
                                MinWidth="148"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center"
                                Content="重新扫描"
                                IsEnabled="{Binding DataContext.CoreStatusCanRebuild, RelativeSource={RelativeSource AncestorType=Window}}"
                                Click="OnManualCodexRescanClick"
                                Style="{DynamicResource SecondaryButtonStyle}" />
                    </Grid>
                    <ToggleButton x:Name="DangerousDataActionsToggle"
                                  Grid.Row="2"
                                  Margin="-8,10,-8,0"
                                  IsChecked="{Binding IsDangerousDataActionsExpanded, Mode=TwoWay}"
                                  AutomationProperties.Name="展开或折叠危险操作"
                                  Style="{StaticResource PriceSectionToggleStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       Text="危险操作"
                                       Style="{DynamicResource BodyTextStyle}" />
                            <TextBlock Grid.Column="1"
                                       Margin="18,0,4,0"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding DangerousDataActionsToggleGlyph}" />
                        </Grid>
                    </ToggleButton>
                    <Border Grid.Row="3"
                            Margin="0,14,0,0"
                            Padding="14,12"
                            Visibility="{Binding IsDangerousDataActionsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{DynamicResource InsetPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ClearStatisticsTitleText"
                                       VerticalAlignment="Center"
                                       Text="清除全部本地统计"
                                       Style="{DynamicResource BodyTextStyle}" />
                            <Button x:Name="ClearStatisticsButton"
                                    Grid.Column="1"
                                    MinWidth="148"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="清除全部统计"
                                    Command="{Binding DataContext.ClearStatisticsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource ErrorBrush}" />
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="GeneralSettingsCardPanel"
                    Grid.Row="5"
                    Margin="{DynamicResource CardStackGap}"
                    Padding="{DynamicResource CardPadding}"
                    Visibility="{Binding IsGeneralSettings, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="StartupRegistrationLabelPanel"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="StartupRegistrationTitleText"
                                       Text="开机自启"
                                       Style="{DynamicResource SectionTitleStyle}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding StartupRegistrationDescription}"
                                       Style="{DynamicResource CaptionTextStyle}" />
                            <TextBlock Margin="0,6,12,0"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       Text="{Binding StartupRegistrationMessage}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasStartupRegistrationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <ToggleButton x:Name="StartupRegistrationToggle"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="开机自启"
                                      AutomationProperties.HelpText="{Binding StartupRegistrationDescription}"
                                      IsChecked="{Binding IsStartupEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding CanChangeStartupRegistration}"
                                      Style="{StaticResource SettingsSwitchStyle}" />
                    </Grid>

                    <Border Grid.Row="1"
                            Height="1"
                            Margin="0,14"
                            Background="{DynamicResource BorderBrush}" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RefreshTitleText"
                                   VerticalAlignment="Center"
                                   Text="界面刷新"
                                   Style="{DynamicResource SectionTitleStyle}" />
                        <Border x:Name="RefreshIntervalPanel"
                                Grid.Column="1"
                                Padding="10,7"
                                VerticalAlignment="Center"
                                Style="{DynamicResource InsetPanelStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           Text="检查间隔"
                                           Style="{DynamicResource CaptionTextStyle}" />
                                <ComboBox Width="112"
                                          ItemsSource="{Binding RefreshIntervalOptions}"
                                          SelectedItem="{Binding RefreshIntervalSeconds, Mode=TwoWay}" />
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="秒"
                                           Style="{DynamicResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="6"
                    Margin="{DynamicResource CardStackGap}"
                    Padding="{DynamicResource CardPadding}"
                    Visibility="{Binding IsPrivacySettings, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="隐私边界"
                               Style="{DynamicResource SectionTitleStyle}" />
                    <StackPanel Grid.Row="1"
                                Margin="0,14,0,0">
                        <TextBlock Text="{Binding CollectionDescription}"
                                   TextWrapping="Wrap"
                                   Style="{DynamicResource SecondaryTextStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding DatabaseAccessDescription}"
                                   TextWrapping="Wrap"
                                   Style="{DynamicResource SecondaryTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
