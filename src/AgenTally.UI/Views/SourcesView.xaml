<UserControl x:Class="AgenTally.UI.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AgenTally.UI.Controls"
             xmlns:usage="clr-namespace:AgenTally.Domain.Usage;assembly=AgenTally.Domain">
    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="数据来源"
                       VerticalAlignment="Center"
                       Style="{DynamicResource PageTitleStyle}" />
            <Button Grid.Column="1"
                    Width="72"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="刷新"
                    Command="{Binding RefreshCommand}"
                    Style="{DynamicResource PrimaryButtonStyle}" />
        </Grid>

        <controls:RoundedClipBorder Grid.Row="1"
                                    Margin="{DynamicResource CardStackGap}"
                                    Style="{DynamicResource TableCardStyle}">
            <Grid>
                <DataGrid x:Name="SourcesGrid"
                          IsReadOnly="True"
                          ItemsSource="{Binding SourceRows}"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="采集状态"
                                                Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="7,3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SurfaceSubtleBrush}"
                                            CornerRadius="7">
                                        <TextBlock Text="{Binding CollectionStatusText}"
                                                   FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CollectionStatusText}" Value="正常">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource PositiveBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="兼容性"
                                                Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="7,3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SurfaceSubtleBrush}"
                                            CornerRadius="7">
                                        <TextBlock Text="{Binding CompatibilityText}"
                                                   FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source.CompatibilityLevel}"
                                                                     Value="{x:Static usage:CompatibilityLevel.FullyCompatible}">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource PositiveBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source.CompatibilityLevel}"
                                                                     Value="{x:Static usage:CompatibilityLevel.PartiallyCompatible}">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source.CompatibilityLevel}"
                                                                     Value="{x:Static usage:CompatibilityLevel.TemporarilyIncompatible}">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource ErrorBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="兼容说明"
                                            Width="260"
                                            Binding="{Binding CompatibilityDescription}"
                                            ElementStyle="{StaticResource DataGridTextStyle}" />
                        <DataGridTextColumn Header="名称"
                                            Width="150"
                                            Binding="{Binding Source.DisplayName}"
                                            ElementStyle="{StaticResource DataGridTextStyle}" />
                        <DataGridTextColumn Header="来源实例"
                                            Width="190"
                                            Binding="{Binding Source.SourceInstanceId}"
                                            ElementStyle="{StaticResource DataGridTextStyle}" />
                        <DataGridTextColumn Header="来源实体"
                                            Width="220"
                                            Binding="{Binding Source.SourceEntityId}"
                                            ElementStyle="{StaticResource DataGridTextStyle}" />
                        <DataGridTextColumn Header="路径"
                                            Width="290"
                                            Binding="{Binding Source.SourcePath}"
                                            ElementStyle="{StaticResource DataGridTextStyle}" />
                        <DataGridTextColumn Header="Agent"
                                            Width="88"
                                            Binding="{Binding Source.AgentId}"
                                            ElementStyle="{StaticResource DataGridTextStyle}" />
                        <DataGridTextColumn Header="类型"
                                            Width="90"
                                            Binding="{Binding Source.SourceKind}"
                                            ElementStyle="{StaticResource DataGridTextStyle}" />
                        <DataGridTextColumn Header="解析版本"
                                            Width="120"
                                            Binding="{Binding Source.ParserVersion, TargetNullValue=—}"
                                            ElementStyle="{StaticResource DataGridTextStyle}" />
                        <DataGridTextColumn Header="最近成功"
                                            Width="150"
                                            Binding="{Binding Source.LastSuccessAtUtc, Converter={StaticResource UtcToLocalDateTimeConverter}}"
                                            ElementStyle="{StaticResource DataGridTextStyle}" />
                        <DataGridTextColumn Header="最近错误"
                                            Width="190"
                                            Binding="{Binding Source.LastError, TargetNullValue=—}"
                                            ElementStyle="{StaticResource DataGridTextStyle}" />
                        <DataGridTextColumn Header="错误时间"
                                            Width="150"
                                            Binding="{Binding Source.LastErrorAtUtc, Converter={StaticResource UtcToLocalDateTimeConverter}}"
                                            ElementStyle="{StaticResource DataGridTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="尚未发现可显示的数据来源"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"
                               BasedOn="{StaticResource MutedTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=SourcesGrid}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </controls:RoundedClipBorder>
    </Grid>
</UserControl>
